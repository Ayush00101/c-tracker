# Discord bot token from the Discord Developer Portal
DISCORD_TOKEN=replace_with_your_bot_token

# Guild where the bot should track voice activity and sync commands instantly
TRACKED_GUILD_ID=replace_with_your_guild_id

# Owner's specific voice channel for /cprofile
TRACKED_VOICE_CHANNEL_ID=replace_with_your_specific_voice_channel_id

# Bot owner's Discord user ID
MAIN_ID=replace_with_owner_user_id

# JSON report file
REPORT_FILE=vc_report.json

# Channel for boss battle alerts and the 24-hour loss announcement
GENERAL_CHANNEL_ID=replace_with_general_channel_id

# Channel for completed Odd-Even match logs
ODDEVEN_LOG_CHANNEL_ID=replace_with_oddeven_log_channel_id
